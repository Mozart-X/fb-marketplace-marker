{
  "manifest_version": 3,
  "name": "Marketplace Tidy",
  "version": "1.1.0",
  "description": "Hide Facebook Marketplace listings individually or by seller, track seen/unseen, and block keywords. 100% local, no tracking.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.facebook.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Marketplace Tidy",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/marketplace/*",
        "*://*.facebook.com/*/marketplace/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
